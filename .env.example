# Gemini API Key (Required on backend for AI Code Evaluation)
GEMINI_API_KEY=YOUR_KEY_HERE

# Optional Gemini Model override (Defaults to gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Leave empty when Vite proxies the local backend during development.
# Set this for a separately hosted API, for example: http://127.0.0.1:8000
VITE_API_BASE_URL=

