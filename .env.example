# Gemini API Key (Required on backend for AI Code Evaluation)
GEMINI_API_KEY=YOUR_KEY_HERE

# Gemini model selected after validating availability and response time for this key.
GEMINI_MODEL=gemini-3.5-flash

# Backend execution/evaluation timeouts
JAVA_COMPILE_TIMEOUT_SECONDS=10
JAVA_RUN_TIMEOUT_SECONDS=5
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_ATTEMPTS=2

# Keep the Vite values paired with the backend Java timeouts above.
VITE_JAVA_COMPILE_TIMEOUT_SECONDS=10
VITE_JAVA_RUN_TIMEOUT_SECONDS=5

# Leave empty when Vite proxies the local backend during development.
# Set this for a separately hosted API, for example: http://127.0.0.1:8000
VITE_API_BASE_URL=
